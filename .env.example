# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=signal
POSTGRES_PASSWORD=signal
POSTGRES_DB=signal_os
DATABASE_URL=postgresql://signal:signal@localhost:5432/signal_os

# ── Neo4j ─────────────────────────────────────────────────────────────────────
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Qdrant ────────────────────────────────────────────────────────────────────
QDRANT_URL=http://localhost:6333

# ── MinIO ─────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# ── AI Providers ──────────────────────────────────────────────────────────────
# Cloud providers are auto-detected from their API keys. The local Ollama
# provider is OPT-IN: set LLM_ALLOW_LOCAL=true and add "ollama" to
# LLM_PROVIDER_ORDER to enable it. A local daemon listening on its default port
# is deliberately not treated as consent — loading multi-gigabyte weights is
# slow and memory-hungry, and on a memory-pressured host every agent's AI pass
# turns into a timeout that stalls the pipeline. The platform is fully
# functional with no LLM configured; agents fall back to deterministic logic.
LLM_ALLOW_LOCAL=false
LLM_PROVIDER_ORDER=openai,anthropic,deepseek,openrouter
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
LLM_TIMEOUT=20
QUILL_LLM_TIMEOUT_S=20
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
DEEPSEEK_API_KEY=sk-...
OPENROUTER_API_KEY=sk-or-...

# ── OSINT Connectors ──────────────────────────────────────────────────────────
SHODAN_API_KEY=
SEARXNG_URL=https://searx.be
SPIDERFOOT_URL=http://localhost:5001

# ── App Config ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8766
SECRET_KEY=change-me-in-production
DEBUG=true
