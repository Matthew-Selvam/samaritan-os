{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "name": "signal-os",
  "buildCommand": "cd frontend && npm install && npm run build",
  "devCommand": "cd frontend && npm install && npm run dev -- --port 3001",
  "installCommand": "cd frontend && npm install",
  "outputDirectory": "frontend/.next",
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/ws/:path*", "destination": "/api/index" }
  ],
  "env": {
    "OPSEC_ENABLED": "false",
    "VAULT_DIR": "/tmp/signal-os/vault_store",
    "SENTINEL_DIR": "/tmp/signal-os/sentinel_store",
    "LLM_ENABLED": "false",
    "DEBUG": "false"
  },
  "build": {
    "env": {
      "NEXT_PUBLIC_API_URL": ""
    }
  }
}
